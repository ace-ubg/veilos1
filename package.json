{
	"name": "veilos",
	"version": "2.0.0-alpha",
	"private": true,
	"description": "VeilOS: a web desktop environment built on Scramjet",
	"type": "module",
	"repository": {
		"type": "git",
		"url": "https://github.com/1sunW/veilos"
	},
	"scripts": {
		"build": "node scripts/copy-assets.mjs",
		"build:host": "rspack build",
		"build:static": "node scripts/patch-sapphire-init.mjs && node scripts/copy-assets.mjs && node scripts/patch-sapphire-init.mjs",
		"dev": "node server.js",
		"start": "node server.js",
		"dev:debug": "DEBUG=1 node server.js",
		"format": "prettier --write .",
		"lint": "eslint ./host/",
		"lint:fix": "eslint ./host/ --fix",
		"lint:workflows": "actionlint .github/workflows/*.yml",
		"lint:all": "npm run lint && npm run lint:workflows",
		"test": "node scripts/check-assets.mjs"
	},
	"keywords": [],
	"author": "",
	"license": "MIT",
	"pnpm": {
		"peerDependencyRules": {
			"allowedVersions": {
				"@mercuryworkshop/scramjet-controller": "0.0.14"
			}
		}
	},
	"overrides": {
		"@mercuryworkshop/scramjet-controller": "0.0.14"
	},
	"resolutions": {
		"@mercuryworkshop/scramjet-controller": "0.0.14"
	},
	"devDependencies": {
		"@eslint/eslintrc": "^3.3.1",
		"@eslint/js": "^9.35.0",
		"@rspack/cli": "^1.5.3",
		"@rspack/core": "^1.5.3",
		"@types/node": "^24.3.1",
		"@typescript-eslint/eslint-plugin": "^8.43.0",
		"@typescript-eslint/parser": "^8.43.0",
		"actionlint": "^2.0.6",
		"eslint": "^9.35.0",
		"prettier": "^3.6.2",
		"tslib": "^2.8.1"
	},
	"dependencies": {
		"@fastify/static": "^8.2.0",
		"@google/genai": "^2.15.0",
		"@mercuryworkshop/epoxy-transport": "3.0.2",
		"@mercuryworkshop/libcurl-transport": "2.0.5",
		"@mercuryworkshop/scramjet": "2.0.67-alpha.2",
		"@mercuryworkshop/scramjet-controller": "0.0.14",
		"@mercuryworkshop/wisp-js": "0.4.1",
		"@nebula-services/bare-server-node": "^2.0.4",
		"@x8r/sapphire": "^0.1.4",
		"dotenv": "^17.2.2",
		"fastify": "^5.6.0",
		"json5": "2.2.3",
		"jszip": "^3.10.2",
		"typescript": "^5.9.2"
	}
}
