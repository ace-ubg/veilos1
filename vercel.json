{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "app": {
      "root": ".",
      "framework": "fastify",
      "entrypoint": "server.js",
      "buildCommand": "npm run build",
      "bindings": [
        {
          "type": "service",
          "service": "onyx-chat",
          "format": "url",
          "env": "ONYX_CHAT_URL"
        }
      ]
    },
    "onyx-chat": {
      "root": "onyx-chat",
      "framework": "vite"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "service": "app"
      }
    }
  ]
}
